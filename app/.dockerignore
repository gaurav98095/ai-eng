# Keep the build context small: it is uploaded to the daemon on every build.
#
# `frontend/` is NOT excluded — web.Dockerfile builds it from source, and
# excluding it makes that COPY fail. Its heavy directories are excluded below,
# which is where the size actually was.
**/node_modules
frontend/dist
# The model services run on Colab, not in any of these images.
services/
**/__pycache__
**/*.pyc
.venv
.git
*.md
docker-compose.yml
