# Copy to .env on the server. No secrets here — credentials come from the
# instance's IAM role.

ENV=aws
LOG_LEVEL=INFO

# The bucket from version 1. Reused as-is.
S3_BUCKET=edgentrag-shubham-2026
AWS_REGION=us-east-1

# All four printed by `python -m scripts.bootstrap`.
#
# ingest and chat are drained by our own workers. stt and embed are drained by
# the GPU through the broker -- the GPU never sees these URLs.
INGEST_QUEUE_URL=
CHAT_QUEUE_URL=
STT_QUEUE_URL=
EMBED_QUEUE_URL=

# The one credential the GPU holds. It authorises "ask the broker for a job"
# and nothing else -- no bucket, no queue, no other session. Revoke it by
# changing this line and restarting.
#
#   openssl rand -hex 32
BROKER_TOKEN=

# Which host port nginx binds. The tunnel reaches it inside the compose
# network, so this only matters if you want to curl it from the box.
WEB_PORT=8080

# Only the two interactive endpoints are reached this way now -- /retrieve and
# /generate, where a person is waiting. Transcription and indexing are pulled
# by the GPU instead, so they need no address at all.
#
# Starting values only. The real ones are set on the app's first screen and
# kept in Redis, because a Colab tunnel is renamed on every restart.
EMBEDDING_SERVICE_URL=http://localhost:8001
STT_SERVICE_URL=http://localhost:8002
LLM_SERVICE_URL=http://localhost:8003
