FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/edgentrag

# Docling's PDF/Word conversion stack needs these shared libraries in the slim
# worker image. The API and other workers stay small because they never import
# document conversion code.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY config.yml config.production.yml ./
COPY src ./src
COPY alembic.ini ./
COPY migrations ./migrations
RUN pip install --no-cache-dir ".[documents]"
CMD ["python", "-m", "edgentrag.ingestion.worker"]
