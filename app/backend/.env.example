# Copy to .env for local development. Do not commit .env.
EDGENTRAG_ENVIRONMENT=local
EDGENTRAG_LOG_LEVEL=INFO
# Local Compose runs PostgreSQL (with pgvector) in Docker. Production points at
# RDS PostgreSQL; both URL forms are normalized by the app.
EDGENTRAG_DATABASE_URL=postgresql+asyncpg://edgentrag:edgentrag@localhost:5432/edgentrag
EDGENTRAG_DB_POOL_SIZE=10
EDGENTRAG_DB_MAX_OVERFLOW=5
EDGENTRAG_REDIS_URL=redis://localhost:6379/0
EDGENTRAG_COGNITO_REGION=
EDGENTRAG_COGNITO_USER_POOL_ID=
EDGENTRAG_COGNITO_CLIENT_ID=
EDGENTRAG_AWS_REGION=us-east-1
EDGENTRAG_AWS_ENDPOINT_URL=http://localhost:4566
EDGENTRAG_S3_BUCKET=edgentrag-test-1
EDGENTRAG_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/edgentrag-test-queue
EDGENTRAG_CHAT_QUEUE_URL=http://localhost:4566/000000000000/edgentrag-chat-queue
EDGENTRAG_STT_QUEUE_URL=http://localhost:4566/000000000000/edgentrag-stt-queue
# Optional local experiment: uncomment with the async-embedding Compose profile.
# EDGENTRAG_EMBEDDING_QUEUE_URL=http://localhost:4566/000000000000/edgentrag-embed-queue
EDGENTRAG_UPLOAD_URL_TTL_SECONDS=900
EDGENTRAG_MAX_UPLOAD_BYTES=20971520
EDGENTRAG_MAX_TEXT_EXTRACT_BYTES=20971520

# Optional: set both values to generate and persist chunk embeddings.
# Keep the token private; export it in your local shell instead of committing it.
# EDGENTRAG_EMBEDDING_SERVICE_URL=https://your-colab-tunnel.trycloudflare.com
# EDGENTRAG_EMBEDDING_API_TOKEN=
# EDGENTRAG_EMBEDDING_BATCH_SIZE=32
# EDGENTRAG_EMBEDDING_REQUEST_TIMEOUT_SECONDS=180
# Independent switches: true = Colab, false = Lightning.
EDGENTRAG_USE_COLAB_FOR_EMBEDDING=true
EDGENTRAG_USE_COLAB_FOR_LLM=true
# EDGENTRAG_COLAB_EMBEDDING_SERVICE_URL=https://embedding.trycloudflare.com
# EDGENTRAG_COLAB_GENERATION_SERVICE_URL=https://generation.trycloudflare.com
# EDGENTRAG_LIGHTNING_EMBEDDING_SERVICE_URL=https://your-embedding-public-host
# EDGENTRAG_LIGHTNING_GENERATION_SERVICE_URL=https://your-generation-public-host
# Each service token must match the selected host. The answer endpoint uses
# the generation URL/token; the queued chat endpoint is acceptance-only until
# its worker is implemented.
# Maximum candidate chunks for the tutorial's in-process semantic search.
# EDGENTRAG_SEARCH_MAX_CHUNKS=5000
