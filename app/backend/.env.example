# Copy to .env for local development. Do not commit .env.
EDGENTRAG_ENVIRONMENT=local
EDGENTRAG_LOG_LEVEL=INFO
EDGENTRAG_DATABASE_URL=sqlite+aiosqlite:///./edgentrag.db
EDGENTRAG_AWS_REGION=us-east-1
EDGENTRAG_AWS_ENDPOINT_URL=http://localhost:4566
EDGENTRAG_S3_BUCKET=edgentrag-test-1
EDGENTRAG_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/edgentrag-test-queue
EDGENTRAG_UPLOAD_URL_TTL_SECONDS=900
EDGENTRAG_MAX_UPLOAD_BYTES=20971520
EDGENTRAG_MAX_TEXT_EXTRACT_BYTES=20971520

# Optional: set both values to generate and persist chunk embeddings.
# Keep the token private; export it in your local shell instead of committing it.
# EDGENTRAG_EMBEDDING_SERVICE_URL=https://your-colab-tunnel.trycloudflare.com
# EDGENTRAG_EMBEDDING_API_TOKEN=
# EDGENTRAG_EMBEDDING_BATCH_SIZE=32
# EDGENTRAG_EMBEDDING_REQUEST_TIMEOUT_SECONDS=180
