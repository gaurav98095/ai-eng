# Copy to .env. Never commit .env or real credentials.

# ============================================================================
# COMMON: required/shared application settings
# ============================================================================
# Allowed values: local, test, production.
EDGENTRAG_ENVIRONMENT=local
EDGENTRAG_LOG_LEVEL=INFO
EDGENTRAG_DB_POOL_SIZE=10
EDGENTRAG_DB_MAX_OVERFLOW=5
EDGENTRAG_UPLOAD_URL_TTL_SECONDS=900
EDGENTRAG_MAX_UPLOAD_BYTES=20971520
EDGENTRAG_MAX_TEXT_EXTRACT_BYTES=20971520
EDGENTRAG_QUEUE_WAIT_SECONDS=20
EDGENTRAG_QUEUE_VISIBILITY_TIMEOUT_SECONDS=900
EDGENTRAG_QUEUE_BATCH_SIZE=10
EDGENTRAG_QUEUE_MAX_RECEIVES=5
EDGENTRAG_EMBEDDING_BATCH_SIZE=32
EDGENTRAG_EMBEDDING_REQUEST_TIMEOUT_SECONDS=180
EDGENTRAG_GENERATION_REQUEST_TIMEOUT_SECONDS=300
EDGENTRAG_SEARCH_MAX_CHUNKS=5000
EDGENTRAG_USE_COLAB_FOR_EMBEDDING=true
EDGENTRAG_USE_COLAB_FOR_LLM=true

# Configure each URL/token pair together, or leave both unset.
# EDGENTRAG_COLAB_EMBEDDING_SERVICE_URL=https://your-colab-embedding-host
# EDGENTRAG_COLAB_GENERATION_SERVICE_URL=https://your-colab-generation-host
# EDGENTRAG_LIGHTNING_EMBEDDING_SERVICE_URL=https://your-lightning-embedding-host
# EDGENTRAG_LIGHTNING_GENERATION_SERVICE_URL=https://your-lightning-generation-host
# EDGENTRAG_EMBEDDING_API_TOKEN=
# EDGENTRAG_GENERATION_API_TOKEN=

# ============================================================================
# LOCAL ONLY: Docker Compose PostgreSQL/Redis + Floci
# ============================================================================
# Switch EDGENTRAG_ENVIRONMENT above to local.
EDGENTRAG_DATABASE_URL=postgresql+asyncpg://edgentrag:edgentrag@localhost:5432/edgentrag
EDGENTRAG_REDIS_URL=redis://localhost:6379/0
EDGENTRAG_REDIS_TLS=false
EDGENTRAG_AWS_REGION=ap-south-1
EDGENTRAG_AWS_ENDPOINT_URL=http://localhost:4566
EDGENTRAG_S3_BUCKET=edgentrag-local
EDGENTRAG_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/edgentrag-local-ingestion
EDGENTRAG_CHAT_QUEUE_URL=http://localhost:4566/000000000000/edgentrag-local-chat
EDGENTRAG_STT_QUEUE_URL=http://localhost:4566/000000000000/edgentrag-local-stt
# Enable only when the async embedding worker profile is running.
# EDGENTRAG_EMBEDDING_QUEUE_URL=http://localhost:4566/000000000000/edgentrag-local-embedding
EDGENTRAG_COGNITO_REGION=
EDGENTRAG_COGNITO_USER_POOL_ID=
EDGENTRAG_COGNITO_CLIENT_ID=

# ============================================================================
# PRODUCTION ONLY: AWS RDS/ElastiCache/S3/SQS/Cognito
# ============================================================================
# Uncomment this section and set EDGENTRAG_ENVIRONMENT=production when deploying.
# EDGENTRAG_DATABASE_URL=postgresql+asyncpg://edgentrag:<password>@<rds-endpoint>:5432/edgentrag
# EDGENTRAG_REDIS_URL=rediss://<elasticache-endpoint>:6379/0
# EDGENTRAG_REDIS_TLS=true
# EDGENTRAG_AWS_REGION=ap-south-1
# EDGENTRAG_AWS_ENDPOINT_URL=
# EDGENTRAG_S3_BUCKET=<terraform output: s3_bucket>
# EDGENTRAG_INGESTION_QUEUE_URL=<terraform output: ingestion_queue_url>
# EDGENTRAG_CHAT_QUEUE_URL=<terraform output: chat_queue_url>
# EDGENTRAG_STT_QUEUE_URL=<terraform output: stt_queue_url>
# EDGENTRAG_EMBEDDING_QUEUE_URL=<terraform output: embedding_queue_url>
# EDGENTRAG_COGNITO_REGION=ap-south-1
# EDGENTRAG_COGNITO_USER_POOL_ID=<terraform output>
# EDGENTRAG_COGNITO_CLIENT_ID=<terraform output>
