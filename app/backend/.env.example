# Copy to .env. Never commit .env, tokens, passwords, or private service URLs.
#
# General application configuration belongs in config.yml. Values here override
# YAML and are for secrets or deployment-specific private endpoints only.

# Configure each URL/token pair together, or leave both unset. Private tunnel
# URLs belong here even though they are not credentials.
# EDGENTRAG_COLAB_EMBEDDING_SERVICE_URL=https://your-colab-embedding-host
# EDGENTRAG_COLAB_GENERATION_SERVICE_URL=https://your-colab-generation-host
# EDGENTRAG_LIGHTNING_EMBEDDING_SERVICE_URL=https://your-lightning-embedding-host
# EDGENTRAG_LIGHTNING_GENERATION_SERVICE_URL=https://your-lightning-generation-host
# EDGENTRAG_COLAB_STT_SERVICE_URL=https://your-colab-stt-host
# EDGENTRAG_LIGHTNING_STT_SERVICE_URL=https://your-lightning-stt-host
# EDGENTRAG_EMBEDDING_API_TOKEN=
# EDGENTRAG_GENERATION_API_TOKEN=
# EDGENTRAG_STT_API_TOKEN=
# Set either switch only alongside the corresponding private URL above.
# EDGENTRAG_USE_COLAB_FOR_EMBEDDING=false
# EDGENTRAG_USE_COLAB_FOR_LLM=false
# EDGENTRAG_USE_COLAB_FOR_STT=false

# AWS/Floci resource overrides. Compose supplies local values automatically;
# production injects these identifiers from Terraform or the secret manager.
# EDGENTRAG_AWS_REGION=ap-south-1
# EDGENTRAG_AWS_ENDPOINT_URL=
# EDGENTRAG_S3_BUCKET=
# EDGENTRAG_INGESTION_QUEUE_URL=
# EDGENTRAG_CHAT_QUEUE_URL=
# EDGENTRAG_STT_QUEUE_URL=
# EDGENTRAG_EMBEDDING_QUEUE_URL=
# EDGENTRAG_COGNITO_REGION=ap-south-1
# EDGENTRAG_COGNITO_USER_POOL_ID=
# EDGENTRAG_COGNITO_CLIENT_ID=
# EDGENTRAG_CORS_ALLOWED_ORIGINS=["https://app.example.com"]

# Optional observability, enabled only when an endpoint is configured. Phoenix
# receives OpenInference traces; Grafana/Alloy receives OTLP logs.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_BASE_URL=http://localhost:6006
# PHOENIX_PROJECT_NAME=edgentrag
# PHOENIX_API_KEY=
# PHOENIX_CLIENT_HEADERS=
# OTEL_SERVICE_NAME=edgentrag-api
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# EDGENTRAG_TELEMETRY_CAPTURE_CONTENT=false

# Database and Redis URLs may embed credentials, so keep them private.
EDGENTRAG_DATABASE_URL=postgresql+asyncpg://edgentrag:edgentrag@localhost:5432/edgentrag
EDGENTRAG_REDIS_URL=redis://localhost:6379/0
